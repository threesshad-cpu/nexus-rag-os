# NEXUS RAG OS local development template. Never commit real .env files.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=768

# local | pinecone | qdrant | auto
VECTOR_BACKEND=local
PINECONE_API_KEY=
PINECONE_INDEX=nexus-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=default
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=nexus_rag

PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
GEMINI_RPM_LIMIT=10
MAX_CHAT_REQUESTS_PER_MINUTE=3
NEXUS_DEMO_MODE=false
NEXUS_ADMIN_TOKEN=
PUBLIC_MCP_URL=
